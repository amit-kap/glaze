{
  "name": "storybook",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run llms && storybook dev -p 6006 --no-open",
    "build": "npm run llms && storybook build -o dist",
    "llms": "node ../../scripts/glaze-llms.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amit-kap/glaze": "*",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.161",
    "@eslint/js": "^10",
    "@shadcn/helpers": "^0.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai": "^7.0.137",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17.13.0",
    "motion": "^14.8.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
